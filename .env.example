# ── Server ──
NODE_ENV=development
PORT=5001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productwriter

# Redis (optional — disables bulk generation and caching if absent)
REDIS_URL=redis://localhost:6379

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-min-32-chars-aaaaaaaaaaaa
JWT_REFRESH_SECRET=change-me-min-32-chars-bbbbbbbbbbbb
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
# In production set this to your deployed frontend URL, e.g. https://app.shopdesc.ai
CLIENT_URL=http://localhost:5173
# In Docker Compose use: AGENTS_URL=http://agents:8000
AGENTS_URL=http://localhost:8000
# Optional but recommended in production. Must match agents AGENT_API_KEY.
AGENT_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Shopify OAuth (optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_CALLBACK_URL=http://localhost:5001/api/auth/shopify/callback

# Email (optional)
RESEND_API_KEY=

# Sentry (optional)
SENTRY_DSN=

# ── Agents ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
# Allowed browser origins for FastAPI CORS, comma-separated
AGENT_CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# ── Client (prefix with VITE_) ──
VITE_API_URL=http://localhost:5001/api
VITE_SENTRY_DSN=
