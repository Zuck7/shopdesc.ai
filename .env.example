# ── Server ──
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/productwriter
REDIS_URL=redis://localhost:6379

# JWT (min 32 chars)
JWT_SECRET=your-jwt-secret-min-32-chars-here-change-me
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173
AGENTS_URL=http://localhost:8000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Shopify OAuth (optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_CALLBACK_URL=http://localhost:5000/api/auth/shopify/callback

# Email (optional)
RESEND_API_KEY=

# Sentry (optional)
SENTRY_DSN=

# ── Agents ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
AGENT_API_KEY=

# ── Client (prefix with VITE_) ──
VITE_API_URL=http://localhost:5000/api
VITE_SENTRY_DSN=
