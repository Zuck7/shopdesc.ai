# Server
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/productwriter
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-character-string-for-access-tokens!!
JWT_REFRESH_SECRET=change-me-to-another-random-64-character-string-for-refresh!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173
AGENTS_URL=http://agents:8000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI / Agent Service
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
